API_KEY=
SECRET_KEY=
PASSPHRASE=

SANDBOX_MODE=true
DRY_RUN=false

SPOT_SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT,XRP/USDT,DOGE/USDT
FUTURES_SYMBOLS=BTC/USDT:USDT,ETH/USDT:USDT,SOL/USDT:USDT,XRP/USDT:USDT,DOGE/USDT:USDT

# Legacy single-symbol fallback. Prefer SPOT_SYMBOLS / FUTURES_SYMBOLS for multi-symbol trading.
SPOT_SYMBOL=BTC/USDT
FUTURES_SYMBOL=BTC/USDT:USDT
QUOTE_CURRENCY=USDT
TIMEFRAME=1m
OHLCV_LIMIT=50
TRADE_INTERVAL_SECONDS=60

RISK_MAX_POSITION_PCT=0.05
RISK_DAILY_MAX_LOSS_PCT=0.10
RISK_MARGIN_RATIO_THRESHOLD=0.20
RISK_STATE_FILE=data/risk_state.json
TRADE_LOG_FILE=data/trades.csv

# Risk hardening
SPOT_STOP_LOSS_PCT=0.02
MAX_OPEN_POSITIONS=3
STOP_OUT_COOLDOWN_SECONDS=900
MAX_ORDER_NOTIONAL_USDT=0
POSITION_REGISTRY_FILE=data/positions.json

FUTURES_MARGIN_MODE=isolated
FUTURES_LEVERAGE=3
FUTURES_POSITION_MODE=net
FUTURES_STOP_LOSS_PCT=0.0075
FUTURES_TAKE_PROFIT_PCT=0.015

RSI_PERIOD=14
RSI_OVERBOUGHT=70
RSI_OVERSOLD=30
ATR_PERIOD=14
ATR_MIN_PCT=0.001
ATR_MAX_PCT=0.05
MA_MIN_TREND_SLOPE_PCT=0.0001
